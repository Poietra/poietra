diff --git a/moonbit/render/geometry_test.mbt b/moonbit/render/geometry_test.mbt
new file mode 100644
index 0000000..5c4693d
--- /dev/null
+++ b/moonbit/render/geometry_test.mbt
@@ -0,0 +1,64 @@
+///|
+test "typed cubics serialize the original SVG quantization exactly" {
+  let base = @scene.default_state(@scene.Path)
+  for
+    value in [
+      0.0,
+      -0.0,
+      0.0000001,
+      -0.0000005,
+      1.23456789,
+      -1.23456789,
+      99999999999999.98,
+      999999999999999.9,
+      1.0e15,
+      1.0e300,
+      0.0 / 0.0,
+      1.0 / 0.0,
+      -1.0 / 0.0,
+    ] {
+    let state = {
+      ..base,
+      width: value,
+      height: -value,
+      path: { c1: { x: value, y: -value, }, c2: { x: -value, y: value, }, },
+    }
+    match shape_geometry(@scene.Path, state) {
+      Some(Cubic(geometry)) => {
+        let expected = "M0 0 C\{number(value)} \{number(-value)} \{number(-value)} \{number(value)} \{number(value)} \{number(-value)}"
+        assert_eq(geometry.path(), expected)
+        match outline_source(Cubic(geometry)) {
+          Measured(source) => assert_eq(source, expected)
+          _ => assert_true(false)
+        }
+      }
+      _ => assert_true(false)
+    }
+  }
+}
+
+///|
+test "cubic cache identity follows displayed coordinates and ignores appearance" {
+  let base = @scene.default_state(@scene.Path)
+  let first = shape_geometry(@scene.Path, { ..base, width: 20.0000001, })
+  assert_true(
+    first ==
+    shape_geometry(@scene.Path, {
+      ..base,
+      width: 20.0000002,
+      x: 100.0,
+      rotation: 45.0,
+      fill: "red",
+    }),
+  )
+  assert_true(
+    first != shape_geometry(@scene.Path, { ..base, width: 20.000001, }),
+  )
+  assert_true(
+    first !=
+    shape_geometry(@scene.Path, {
+      ..base,
+      path: { ..base.path, c1: { ..base.path.c1, x: base.path.c1.x + 1.0, }, },
+    }),
+  )
+}
