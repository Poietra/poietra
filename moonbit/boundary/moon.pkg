import {
  "mizchi/js_core" @core,
  "poietra/poietra/scene",
  "poietra/poietra/geometry",
  "poietra/poietra/collaboration",
}

options(
  targets: {
    "scene.mbt": [ "js" ],
    "playback.mbt": [ "js" ],
    "structure.mbt": [ "js" ],
    "document.mbt": [ "js" ],
    "shared.mbt": [ "js" ],
    "adapters.mbt": [ "js" ],
    "geometry.mbt": [ "js" ],
  },
  link: {
    "js": {
      "exports": [
        "to_shared:toShared",
        "initialize_document:initializeDocument",
        "get_shared:getShared",
        "get_value:getValue",
        "apply_changes:applyChanges",
        "changes_for:changesFor",
        "ensure_scene_audio_tracks:ensureSceneAudioTracks",
        "ensure_scene_animation_tracks:ensureSceneAnimationTracks",
        "read_project:readProject",
        "scene_structure_view:sceneStructureView",
        "project_structure_view:projectStructureView",
        "prepare_playback:preparePlayback",
        "playback_frame:playbackFrame",
        "playback_composition:playbackComposition",
        "playback_transition:playbackTransition",
        "rotate_vector:rotateVector",
        "world_to_local:worldToLocal",
        "local_to_world:localToWorld",
        "point_in_rotated_bounds:pointInRotatedBounds",
        "rectangle_from_points:rectangleFromPoints",
        "rectangle_contains_rotated_bounds:rectangleContainsRotatedBounds",
        "resize_from_corner:resizeFromCorner",
        "rotation_from_pointer:rotationFromPointer",
        "evaluate_scene:evaluateScene",
        "composition_frame:compositionFrame",
        "transition_frame:transitionFrame",
        "scene_segments:sceneSegments",
        "scene_duration:sceneDuration",
      ],
      "format": "esm",
    },
  },
)
