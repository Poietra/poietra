import {
  "mizchi/js_core" @core,
  "poietra/poietra/scene",
  "poietra/poietra/geometry",
  "poietra/poietra/editor",
  "poietra/poietra/collaboration",
}

options(
  targets: {
    "scene.mbt": [ "js" ],
    "playback.mbt": [ "js" ],
    "structure.mbt": [ "js" ],
    "document.mbt": [ "js" ],
    "shared.mbt": [ "js" ],
    "editing.mbt": [ "js" ],
    "groups.mbt": [ "js" ],
    "timeline.mbt": [ "js" ],
    "adapters.mbt": [ "js" ],
    "geometry.mbt": [ "js" ],
  },
  link: {
    "js": {
      "exports": [
        "group_members:groupMembers",
        "editable_group_members:editableGroupMembers",
        "visible_animation:visibleAnimation",
        "visible_animations:visibleAnimations",
        "group_animation_targets:groupAnimationTargets",
        "group_animation_changes:groupAnimationChanges",
        "common_track_value:commonTrackValue",
        "new_id:newId",
        "format_milliseconds:formatMilliseconds",
        "project_segments:projectSegments",
        "project_duration:projectDuration",
        "project_segment_at:projectSegmentAt",
        "is_valid_easing:isValidEasing",
        "easings_equal:easingsEqual",
        "default_state:defaultState",
        "default_track:defaultTrack",
        "resolve_track:resolveTrack",
        "implicit_tracks:implicitTracks",
        "property_timing_key:propertyTimingKey",
        "get_property_timing:getPropertyTiming",
        "has_property_timing:hasPropertyTiming",
        "track_timing_end:trackTimingEnd",
        "validate_animation_timing:validateAnimationTiming",
        "validate_animation_track:validateAnimationTrack",
        "clamp:clamp",
        "state_for:stateFor",
        "ordered_objects:orderedObjects",
        "to_shared:toShared",
        "initialize_document:initializeDocument",
        "get_shared:getShared",
        "get_value:getValue",
        "apply_changes:applyChanges",
        "changes_for:changesFor",
        "ensure_scene_audio_tracks:ensureSceneAudioTracks",
        "ensure_scene_animation_tracks:ensureSceneAnimationTracks",
        "read_project:readProject",
        "scene_structure_view:sceneStructureView",
        "project_structure_view:projectStructureView",
        "prepare_playback:preparePlayback",
        "playback_frame:playbackFrame",
        "playback_composition:playbackComposition",
        "playback_transition:playbackTransition",
        "rotate_vector:rotateVector",
        "world_to_local:worldToLocal",
        "local_to_world:localToWorld",
        "point_in_rotated_bounds:pointInRotatedBounds",
        "rectangle_from_points:rectangleFromPoints",
        "rectangle_contains_rotated_bounds:rectangleContainsRotatedBounds",
        "resize_from_corner:resizeFromCorner",
        "rotation_from_pointer:rotationFromPointer",
        "evaluate_scene:evaluateScene",
        "composition_frame:compositionFrame",
        "transition_frame:transitionFrame",
        "scene_segments:sceneSegments",
        "scene_duration:sceneDuration",
      ],
      "format": "esm",
    },
  },
)
