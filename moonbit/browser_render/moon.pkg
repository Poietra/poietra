import {
  "mizchi/js_core" @core,
  "mizchi/js_browser/canvas",
  "mizchi/js_builtin/regexp",
  "moonbitlang/core/math",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/string",
  "poietra/poietra/render",
  "poietra/poietra/scene",
  "poietra/poietra/editor",
  "poietra/poietra/boundary",
}

supported_targets = "js"

options(
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "create_glow_renderer:createGlowRenderer",
        "create_frame_painter:createFramePainter",
        "draw_svg_frame:drawSvgFrame",
        "create_layer_cache:createLayerCache",
        "text_drawing_key:textDrawingKey",
        "prepare_text_drawing:prepareTextDrawing",
        "with_svg_image:withSvgImage",
        "prepare_shape_drawing:prepareShapeDrawing",
        "prepare_equation_drawing:prepareEquationDrawing",
        "prepare_equations:prepareEquations",
        "get_equation:getEquation",
        "create_font_catalog:createFontCatalog",
        "prepare_fonts:prepareFonts",
        "embedded_font_styles:embeddedFontStyles",
        "measure_text:measureText",
      ],
    },
  },
)
