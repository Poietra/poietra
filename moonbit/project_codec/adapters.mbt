///|
extern "js" fn make_Point(x : Double, y : Double) -> @core.Any =
  #|(x, y) => ({x, y})

///|
pub fn encode_Point(value : @scene.Point) -> @core.Any {
  make_Point(value.x, value.y)
}

///|
extern "js" fn make_Bezier(c1 : @core.Any, c2 : @core.Any) -> @core.Any =
  #|(c1, c2) => ({c1, c2})

///|
pub fn encode_Bezier(value : @scene.Bezier) -> @core.Any {
  make_Bezier(encode_Point(value.c1), encode_Point(value.c2))
}

///|
extern "js" fn make_ObjectState(
  x : Double,
  y : Double,
  width : Double,
  height : Double,
  rotation : Double,
  anchorX : @core.Any,
  anchorY : @core.Any,
  scaleX : @core.Any,
  scaleY : @core.Any,
  shear : @core.Any,
  opacity : Double,
  visible : Bool,
  fill : String,
  stroke : String,
  strokeWidth : Double,
  text : String,
  fontSize : Double,
  cornerRadius : Double,
  effect : String,
  path : @core.Any,
  graph : @core.Any,
  geometry : @core.Any,
  network : @core.Any,
  surface : @core.Any,
) -> @core.Any =
  #|(x, y, width, height, rotation, anchorX, anchorY, scaleX, scaleY, shear, opacity, visible, fill, stroke, strokeWidth, text, fontSize, cornerRadius, effect, path, graph, geometry, network, surface) => { const value = {x, y, width, height, rotation, opacity, visible, fill, stroke, strokeWidth, text, fontSize, cornerRadius, effect, path}; if (anchorX !== undefined) value.anchorX = anchorX; if (anchorY !== undefined) value.anchorY = anchorY; if (scaleX !== undefined) value.scaleX = scaleX; if (scaleY !== undefined) value.scaleY = scaleY; if (shear !== undefined) value.shear = shear; if (graph !== undefined) value.graph = graph; if (geometry !== undefined) value.geometry = geometry; if (network !== undefined) value.network = network; if (surface !== undefined) value.surface = surface; return value; }

///|
pub fn encode_ObjectState(value : @scene.ObjectState) -> @core.Any {
  make_ObjectState(
    value.x,
    value.y,
    value.width,
    value.height,
    value.rotation,
    match value.anchorX {
      Some(item) => @core.any(item)
      None => @core.undefined()
    },
    match value.anchorY {
      Some(item) => @core.any(item)
      None => @core.undefined()
    },
    match value.scaleX {
      Some(item) => @core.any(item)
      None => @core.undefined()
    },
    match value.scaleY {
      Some(item) => @core.any(item)
      None => @core.undefined()
    },
    match value.shear {
      Some(item) => @core.any(item)
      None => @core.undefined()
    },
    value.opacity,
    value.visible,
    value.fill,
    value.stroke,
    value.strokeWidth,
    value.text,
    value.fontSize,
    value.cornerRadius,
    @scene.effect_name(value.effect),
    encode_Bezier(value.path),
    match value.graph {
      Some(item) => encode_GraphDefinition(item)
      None => @core.undefined()
    },
    match value.geometry {
      Some(item) => encode_GeometryDefinition(item)
      None => @core.undefined()
    },
    match value.network {
      Some(item) => encode_NetworkDefinition(item)
      None => @core.undefined()
    },
    match value.surface {
      Some(item) => encode_SurfaceDefinition(item)
      None => @core.undefined()
    },
  )
}

///|
extern "js" fn make_curve(
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
) -> @core.Any =
  #|(x1, y1, x2, y2) => ({type: 'cubicBezier', x1, y1, x2, y2})

///|
pub fn encode_Easing(value : @scene.Easing) -> @core.Any {
  match value {
    Linear => @core.any("linear")
    EaseInOut => @core.any("easeInOut")
    EaseIn => @core.any("easeIn")
    EaseOut => @core.any("easeOut")
    CubicBezier(x1, y1, x2, y2) => make_curve(x1, y1, x2, y2)
  }
}

///|
pub fn encode_Timing(value : @scene.Timing) -> @core.Any {
  make_timing(
    @core.any(value.start),
    @core.any(value.duration),
    encode_Easing(value.easing),
  )
}

///|
extern "js" fn make_track(
  object_id : String,
  kind : String,
  start : Double,
  duration : Double,
  easing : @core.Any,
  order : String,
  path : @core.Any,
) -> @core.Any =
  #|(objectId, type, start, duration, easing, order, path) => ({objectId, type, start, duration, easing, order, path})

///|
pub fn encode_Track(value : @scene.Track) -> @core.Any {
  let path = match value.path {
    Some(path) => encode_Bezier(path)
    None => @core.null()
  }
  let result = make_track(
    value.objectId,
    @scene.animation_name(value.type_),
    value.start,
    value.duration,
    encode_Easing(value.easing),
    @scene.write_order_name(value.order),
    path,
  )
  if value.implicit is Some(item) {
    put_own(result, "implicit", @core.any(item))
  }
  if value.positionTiming is Some(item) {
    put_own(result, "positionTiming", encode_Timing(item))
  }
  if value.opacityTiming is Some(item) {
    put_own(result, "opacityTiming", encode_Timing(item))
  }
  if value.sizeTiming is Some(item) {
    put_own(result, "sizeTiming", encode_Timing(item))
  }
  if value.rotationTiming is Some(item) {
    put_own(result, "rotationTiming", encode_Timing(item))
  }
  if value.fillTiming is Some(item) {
    put_own(result, "fillTiming", encode_Timing(item))
  }
  if value.strokeTiming is Some(item) {
    put_own(result, "strokeTiming", encode_Timing(item))
  }
  if value.strokeWidthTiming is Some(item) {
    put_own(result, "strokeWidthTiming", encode_Timing(item))
  }
  if value.fontSizeTiming is Some(item) {
    put_own(result, "fontSizeTiming", encode_Timing(item))
  }
  if value.cornerRadiusTiming is Some(item) {
    put_own(result, "cornerRadiusTiming", encode_Timing(item))
  }
  if value.pathTiming is Some(item) {
    put_own(result, "pathTiming", encode_Timing(item))
  }
  if value.revealTiming is Some(item) {
    put_own(result, "revealTiming", encode_Timing(item))
  }
  if value.graphTiming is Some(item) {
    put_own(result, "graphTiming", encode_Timing(item))
  }
  if value.keyframes is Some(item) {
    put_own(
      result,
      "keyframes",
      encode_map(item, fn(item) { encode_Keyframe(item) }),
    )
  }
  result
}

///|
pub fn[T] encode_array(
  value : Array[T],
  convert : (T) -> @core.Any,
) -> @core.Any {
  @core.any(FixedArray::makei(value.length(), fn(i) { convert(value[i]) }))
}

///|
pub fn[T] encode_map(
  value : Map[String, T],
  convert : (T) -> @core.Any,
) -> @core.Any {
  let result = @core.new_object()
  for key, item in value {
    put_own(result, key, convert(item))
  }
  result
}

///|
pub fn encode_GraphDefinition(value : @scene.GraphDefinition) -> @core.Any {
  let result = @core.new_object()
  put_own(result, "syntaxVersion", @core.any(value.syntaxVersion))
  put_own(result, "expression", @core.any(value.expression))
  put_own(result, "xMin", @core.any(value.xMin))
  put_own(result, "xMax", @core.any(value.xMax))
  put_own(result, "yMin", @core.any(value.yMin))
  put_own(result, "yMax", @core.any(value.yMax))
  put_own(result, "a", @core.any(value.a))
  put_own(result, "b", @core.any(value.b))
  put_own(result, "c", @core.any(value.c))
  put_own(result, "axes", @core.any(value.axes))
  put_own(result, "grid", @core.any(value.grid))
  put_own(
    result,
    "breaks",
    encode_array(value.breaks, fn(item) { @core.any(item) }),
  )
  result
}

