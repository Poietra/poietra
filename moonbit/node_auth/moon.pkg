import {
  "mizchi/js_core" @core,
  "mizchi/js_node/fs",
  "poietra/poietra/auth_policy" @policy,
  "poietra/poietra/auth_service" @auth,
  "poietra/poietra/http_runtime" @http,
}

supported_targets = "js"

options(
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "repository_class:nodeAuthRepositoryClass",
        "create_node_auth:createNodeAuth",
      ],
    },
  },
)
