import {
  "mizchi/js_core" @core,
  "mizchi/js_builtin/collection",
  "poietra/poietra/assets",
  "poietra/poietra/audio",
}

supported_targets = "js"

options(
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "create_audio_mixer:createAudioMixer",
        "audible_tracks:audibleTracks",
        "create_video_frames:createVideoFrames",
        "prepare_video_frame:prepareVideoFrame",
        "prepared_image:preparedImage",
        "prepare_images:prepareImages",
        "open_media:openMedia",
        "prepare_media:prepareMedia",
        "upload_media:uploadMedia",
        "media_blob:mediaBlob",
        "normalize_image:normalizeImage",
        "upload_image:uploadImage",
        "image_blob:imageBlob",
        "blob_data_url:blobDataUrl",
      ],
    },
  },
)
