    "js": {
      "format": "esm",
      "exports": [
        "scene_tabs:SceneTabs",
        "playback_panel:PlaybackPanel",
        "chat_thinking:ChatThinking",
        "connection_presentation:connectionPresentation",
        "connection_status:ConnectionStatus",
        "use_operation_feedback:useOperationFeedback",
        "operation_feedback:OperationFeedback",
        "icon_button:IconButton",
        "field:Field",
        "number_input:NumberInput",
        "modal:Modal",
        "section:Section",
      ],
    },
  },
)
