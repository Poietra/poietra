    "typecheck": "pnpm --dir apps/studio typecheck"
  },
  "dependencies": {
    "react": "19.3.0"
  },
  "imports": {
    "#poietra/ui-host": "./apps/studio/src/platform/ui-host.mjs"
  }
}
